# Copy to docker/.env and run ./generate-secrets.sh to fill the secrets.

# Which bundled services to run:
#   postgres - PostgreSQL in Docker
#   supabase - auth, REST, realtime and storage services, on the bundled or your own PostgreSQL
#   qdrant   - Qdrant vector store in Docker
#   s3       - S3-compatible file storage (MinIO) in Docker
# Remove one to use an external service instead (see docs/self-hosting.md).
COMPOSE_PROFILES=postgres,supabase,qdrant,s3

# --- Public URLs: how browsers reach each service ---
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
SUPABASE_PUBLIC_URL=http://localhost:8000
S3_PUBLIC_URL=http://localhost:9000

# --- Host ports. Set *_BIND=0.0.0.0 to expose a port beyond this machine ---
APP_BIND=127.0.0.1
APP_PORT=3000
API_BIND=127.0.0.1
API_PORT=4000
SUPABASE_BIND=127.0.0.1
SUPABASE_PORT=8000
S3_BIND=127.0.0.1
S3_PORT=9000

# --- Secrets (filled by ./generate-secrets.sh) ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REALTIME_SECRET_KEY_BASE=
ENCRYPTION_KEY=
API_KEY_HASH_SECRET=
QDRANT_API_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email ---
# smtp or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Defaults to true only when SMTP_PORT is 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Receives contact form and feedback messages
ADMIN_EMAIL=admin@example.com

# --- Sign-in ---
DISABLE_SIGNUP=false
JWT_EXPIRY=3600
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=

# --- AI providers ---
# Private hosts (comma-separated) that provider base URLs may use, for example a model server on your network
PROVIDER_ALLOWED_PRIVATE_HOSTS=

# --- Limits applied to every user on each start ---
WORKSPACE_LIMIT=1000
STORAGE_CAPACITY_GB=1000000

# --- Vector store: qdrant, lancedb or pgvector ---
VECTOR_STORE=qdrant
# Qdrant Cloud or another Qdrant server (remove "qdrant" from COMPOSE_PROFILES):
# QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
# LanceDB location, a path inside the containers or s3://bucket/path:
# LANCEDB_URI=/data/lancedb

# --- Your own database (only when "postgres" is not in COMPOSE_PROFILES) ---
# The admin user must be able to create roles and schemas.
# The password must be URL-safe or percent-encoded.
# DB_HOST=db.example.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_ADMIN_USER=postgres
# DB_ADMIN_PASSWORD=
# DB_SSLMODE=require

# --- Your own Supabase project (only when "postgres" and "supabase" are not in COMPOSE_PROFILES) ---
# Also set DB_* above to the project's database (Project Settings > Database).
# SUPABASE_INTERNAL_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co
# ANON_KEY=
# SERVICE_ROLE_KEY=
# JWT_SECRET=

# --- External S3 (only when "s3" is not in COMPOSE_PROFILES) ---
# Leave S3_ENDPOINT empty for AWS S3, or set it for another S3-compatible service.
# S3_ENDPOINT=
# S3_BUCKET=layerum-sources
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=AES256
