map_hash_bucket_size 512;

map $http_apikey $request_apikey {
  ""      $arg_apikey;
  default $http_apikey;
}

map $request_apikey $apikey_valid {
  "${ANON_KEY}"         1;
  "${SERVICE_ROLE_KEY}" 1;
  default               0;
}

map "$request_method:$apikey_valid" $apikey_denied {
  "~^OPTIONS:" 0;
  "~:1$"       0;
  default      1;
}

map $http_authorization $upstream_authorization {
  ""      "Bearer $request_apikey";
  default $http_authorization;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

server {
  listen 8000;
  client_max_body_size 50m;

  # Resolve containers per request so restarted services are picked up.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $auth http://supabase-auth:9999;
  set $rest http://supabase-rest:3000;
  set $realtime http://supabase-realtime:4000;
  set $storage http://supabase-storage:5000;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location ~ ^/auth/v1/(verify|callback|authorize|\.well-known/jwks\.json) {
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_pass $auth;
  }

  location /auth/v1/ {
    if ($apikey_denied) { return 401; }
    rewrite ^/auth/v1/(.*)$ /$1 break;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $upstream_authorization;
    proxy_pass $auth;
  }

  location /rest/v1/ {
    if ($apikey_denied) { return 401; }
    rewrite ^/rest/v1/(.*)$ /$1 break;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $upstream_authorization;
    proxy_pass $rest;
  }

  location /realtime/v1/api/ {
    return 403;
  }

  location /realtime/v1/ {
    if ($apikey_denied) { return 401; }
    rewrite ^/realtime/v1/(.*)$ /socket/$1 break;
    # Realtime reads the tenant id from the first label of the Host header.
    proxy_set_header Host realtime-dev.supabase-realtime;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
    proxy_pass $realtime;
  }

  location /storage/v1/ {
    rewrite ^/storage/v1/(.*)$ /$1 break;
    proxy_pass $storage;
  }

  location / {
    return 404;
  }
}
